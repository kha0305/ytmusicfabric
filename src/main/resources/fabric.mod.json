{
	"schemaVersion": 1,
	"id": "ytmusicfabric",
	"version": "${version}",
	"name": "YT Music Fabric",
	"description": "Mod Fabric client-side phát nhạc từ link YouTube bằng yt-dlp và ffmpeg.",
	"authors": [
		"Codex"
	],
	"license": "CC0-1.0",
