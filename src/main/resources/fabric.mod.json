	"entrypoints": {
		"client": [
			"vn.ytmusicfabric.client.YtMusicFabricClient"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	}
